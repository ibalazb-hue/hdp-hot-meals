PORT=8787
NODE_ENV=development
# Required when NODE_ENV=production. Any long random string (32+ chars).
JWT_SECRET=change-me-before-live-use
# Leave unset to use the built-in PostgreSQL-compatible file database (PGlite).
# For multi-tablet / production, set a real Postgres URL (Neon, Railway Postgres, etc.).
# DATABASE_URL=postgres://hdp:hdp@localhost:5432/hdp
# Dev/test: omit or SEED=true to load training users/households.
# Production: omit or SEED=false (default). Set SEED=true only for a training server.
SEED=true

# Entitlement card print (optional). Shown on printable QR cards.
# CARD_VALID_FROM=2026-01-01
# CARD_VALID_TO=2026-12-31
# WFP_HOTLINE=+967-X-XXX-XXX
# HDP_HOTLINE=+967-X-XXX-XXX
